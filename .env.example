# Environment configuration - Pembo e-Hub
# Copy this file to .env and fill in real values. Never commit .env.

# Database (MySQL/MariaDB via PDO)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pembo_ehub_db
DB_USER=root
DB_PASS=

# Gmail SMTP (transactional email)
# Use a Gmail App Password (Google Account -> Security -> App passwords).
SMTP_HOST=smtp.gmail.com
GMAIL_USER=no-reply@pembo.gov.ph
GMAIL_APP_PASSWORD=
SMTP_PORT=587
SMTP_FROM_NAME="Pembo e-Hub"

APP_ENV=development
